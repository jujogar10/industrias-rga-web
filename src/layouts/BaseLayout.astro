---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { routes, type Lang } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  path?: keyof typeof routes.es;
  ogImage?: string;
}

const {
  title,
  description,
  lang = "es",
  path = "home",
  ogImage = "/og-image.png",
} = Astro.props;

const site = Astro.site!.origin;
const canonicalPath = routes[lang][path];
const canonicalURL = new URL(canonicalPath, site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang="es" href={new URL(routes.es[path], site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(routes.en[path], site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(routes.es[path], site).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Industrias RGA",
      "url": site,
      "logo": new URL("/favicon.svg", site).toString(),
      "sameAs": []
    })} />
  </head>
  <body class="bg-white text-rga-text font-body antialiased">
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
