---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Mail } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import ruedaBf from "../../assets/productos/rueda-bf.png";
import soporteGiratorio from "../../assets/productos/soporte-giratorio.png";
import { CONTACT } from "../../config/contact";
import { useTranslations } from "../../i18n/ui";

const lang = "es" as const;
const t = useTranslations(lang);
const categorias = (await getCollection("categorias")).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const posterMap = {
  ruedas: ruedaBf,
  soportes: soporteGiratorio,
} as const;
---

<BaseLayout
  lang={lang}
  title="Catálogo — RGA"
  description="Ruedas, soportes y rodachinas industriales fabricados y distribuidos por RGA en Colombia."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-rga-text">
      {t("products.title")}
    </h1>
    <p class="mt-3 max-w-2xl font-body text-rga-text-secondary">
      {t("products.subtitle")}
    </p>

    <div class="mt-16 flex flex-col gap-20">
      {
        categorias.map((categoria, i) => {
          const poster =
            posterMap[categoria.data.slug as keyof typeof posterMap];
          const video = categoria.data.video;
          const nombre = categoria.data.nombre[lang];
          const descripcion = categoria.data.descripcion[lang];
          return (
            <div
              id={categoria.data.slug}
              class:list={[
                "grid scroll-mt-24 gap-10 md:grid-cols-2 md:items-center",
                i % 2 === 1 && "md:[&>*:first-child]:order-2",
              ]}
            >
              <div class="aspect-square overflow-hidden rounded-[--radius-card] bg-rga-navy">
                {video ? (
                  <video
                    class="h-full w-full object-cover"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster={poster?.src}
                  >
                    <source src={video} type="video/mp4" />
                  </video>
                ) : poster ? (
                  <Image
                    src={poster}
                    alt={nombre}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center font-heading text-white/40">
                    {nombre}
                  </div>
                )}
              </div>
              <div>
                <h2 class="font-heading text-2xl font-medium text-rga-text">
                  {nombre}
                </h2>
                <p class="mt-4 font-body text-rga-text-secondary">
                  {descripcion}
                </p>
                <div class="mt-6 flex flex-wrap gap-4">
                  <WhatsAppButton lang={lang} />
                  <a
                    href={`mailto:${CONTACT.email}`}
                    class="inline-flex items-center gap-2 rounded-[--radius-card] border border-rga-border px-5 py-3 font-body text-sm font-medium text-rga-navy hover:bg-rga-bg-alt"
                  >
                    <Mail size={18} />
                    {t("cta.email")}
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
