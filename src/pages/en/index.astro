---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ProductCategoryCard from "../../components/ProductCategoryCard.astro";
import { useTranslations } from "../../i18n/ui";

const lang = "en" as const;
const t = useTranslations(lang);
const categorias = (await getCollection("categorias")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<BaseLayout
  lang={lang}
  title="RGA — Industrial Wheels and Supports"
  description="Colombian manufacturer and distributor of industrial wheels, supports, and casters."
>
  <Hero lang={lang} videoSrc="/videos/hero.mp4" />

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-center font-heading text-3xl font-semibold text-rga-text">
      {t("products.title")}
    </h2>
    <p class="mt-3 text-center font-body text-rga-text-secondary">
      {t("products.subtitle")}
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        categorias.map((categoria) => (
          <ProductCategoryCard lang={lang} categoria={categoria} />
        ))
      }
    </div>
  </section>
</BaseLayout>
