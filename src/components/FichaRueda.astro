---
import { Mail } from "@lucide/astro";
import { CATALOGO } from "../i18n/catalogo";
import { routes, useTranslations, type Lang } from "../i18n/ui";
import { CONTACT } from "../config/contact";
import { urlImagen } from "../lib/vista";
import type { Catalogo, Rueda } from "../lib/catalogo";

interface Props {
  lang: Lang;
  rueda: Rueda;
  catalogo: Catalogo;
}

const { lang, rueda, catalogo } = Astro.props;
const textos = CATALOGO[lang];
const locale = lang === "es" ? "es-CO" : "en-US";
const t = useTranslations(lang);

const nombre = (lista: { id: string; nombre: Record<Lang, string> }[], id: string | null) =>
  id ? (lista.find((x) => x.id === id)?.nombre[lang] ?? id) : null;

const material = nombre(catalogo.materiales, rueda.banda);
const linea = nombre(catalogo.lineas, rueda.linea);
const nucleo = nombre(catalogo.nucleos, rueda.nucleo);
const rodamiento = nombre(catalogo.rodamientos, rueda.rodamiento);
const imagen = await urlImagen(rueda.imagen);
const aplicaciones = rueda.aplicaciones[lang];

const specs = [
  [textos.capacidad, `${rueda.capacidadKg.toLocaleString(locale)} kg`],
  [textos.diametro, rueda.diametro.texto],
  [textos.especAncho, rueda.ancho?.texto],
  [textos.especEje, rueda.eje?.texto],
  [textos.material, material],
  [textos.especDureza, rueda.durezaShore],
  [textos.nucleo, nucleo],
  [textos.rodamiento, rodamiento],
  [textos.temperatura, rueda.tempMaxC ? `${rueda.tempMaxC} °C` : null],
  [textos.linea, linea],
].filter(([, valor]) => valor) as [string, string][];

const mensaje = encodeURIComponent(
  lang === "es"
    ? `Hola, me interesa la referencia ${rueda.referencia}.`
    : `Hello, I'm interested in reference ${rueda.referencia}.`,
);
---

<section class="mx-auto max-w-5xl px-6 py-20">
  <a
    href={routes[lang].wheels}
    class="font-body text-sm text-rga-navy underline-offset-4 hover:underline"
  >
    &larr; {textos.volver}
  </a>

  <div class="mt-8 grid gap-12 md:grid-cols-2 md:items-start">
    <div class="aspect-square overflow-hidden rounded-[--radius-card] bg-rga-bg-alt">
      {
        imagen ? (
          <img
            src={imagen}
            alt={`${linea} ${rueda.diametro.texto}`}
            class="h-full w-full object-contain"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center font-heading text-rga-acero-light">
            {rueda.referencia}
          </div>
        )
      }
    </div>

    <div>
      <p class="font-mono-tech text-sm text-rga-text-secondary">{rueda.referencia}</p>
      <h1 class="mt-1 font-heading text-3xl font-semibold text-rga-text">
        Ø{rueda.diametro.texto} · {material}
      </h1>
      <p class="mt-4 font-heading text-4xl font-semibold text-rga-navy">
        {rueda.capacidadKg.toLocaleString(locale)} kg
      </p>
      <p class="font-body text-sm text-rga-text-secondary">{textos.capacidadPorRueda}</p>

      <h2 class="mt-10 font-heading text-lg font-medium text-rga-text">
        {textos.especificaciones}
      </h2>
      <dl class="mt-4 divide-y divide-rga-border border-y border-rga-border">
        {
          specs.map(([etiqueta, valor]) => (
            <div class="flex justify-between gap-6 py-2.5">
              <dt class="font-body text-sm text-rga-text-secondary">{etiqueta}</dt>
              <dd class="font-mono-tech text-sm text-rga-text">{valor}</dd>
            </div>
          ))
        }
      </dl>

      {
        aplicaciones.length > 0 && (
          <>
            <h2 class="mt-8 font-heading text-lg font-medium text-rga-text">
              {textos.aplicaciones}
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {aplicaciones.map((a) => (
                <li class="rounded-[--radius-card] bg-rga-bg-alt px-3 py-1.5 font-body text-sm text-rga-acero-dark">
                  {a}
                </li>
              ))}
            </ul>
          </>
        )
      }

      <div class="mt-10 rounded-[--radius-card] bg-rga-bg-alt p-6">
        <p class="font-heading text-lg text-rga-text">{textos.fichaCta}</p>
        <p class="mt-1 font-body text-sm text-rga-text-secondary">{textos.fichaCtaSub}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={`https://wa.me/${CONTACT.whatsappNumber}?text=${mensaje}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center rounded-[--radius-card] bg-rga-navy px-5 py-3 font-body text-sm font-medium text-white hover:bg-rga-navy-hover"
          >
            {t("cta.whatsapp")}
          </a>
          <a
            href={`mailto:${CONTACT.email}?subject=${rueda.referencia}`}
            class="inline-flex items-center gap-2 rounded-[--radius-card] border border-rga-border bg-white px-5 py-3 font-body text-sm font-medium text-rga-navy hover:bg-white"
          >
            <Mail size={18} />
            {t("cta.email")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
