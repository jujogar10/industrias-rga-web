---
import { Image, getImage } from "astro:assets";
import logo from "../assets/marca/logo-rga-trimmed.png";
import motionWave from "../assets/marca/motion-wave.png";
import { useTranslations, routes, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const otherLang = lang === "es" ? "en" : "es";

// Banda "Motion Wave" del sistema de fichas técnicas, reutilizada en el
// header — ver Marca/Guia-Marca-RGA.md y Marca/Hero RGA.png. Solo se pinta
// desde sm: para arriba (ver <style>), así el header en mobile queda plano.
const wave = await getImage({ src: motionWave, width: 1100, format: "webp" });
---

<header
  class="header-wave sticky top-0 z-50 border-rga-border bg-white sm:border-b"
  style={`--wave-url: url(${wave.src})`}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href={r.home} class="flex items-center">
      <Image src={logo} alt="RGA" height={32} width={82} />
    </a>

    <!-- Mobile (sin wave, ver <style>): en flujo, entre logo y switch,
         como un header normal. Desde sm: se saca del flujo y se centra
         sobre el header completo, no sobre esta columna, para que quede
         a la mitad de la pantalla sin importar cuánto pese el logo a la
         izquierda o "EN" a la derecha. -->
    <nav
      class="flex items-center gap-4 font-body text-sm text-rga-text sm:absolute sm:left-1/2 sm:top-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 sm:gap-5"
    >
      <a href={r.home} class="hover:text-rga-navy">{t("nav.home")}</a>
      <a href={r.products} class="hover:text-rga-navy">{t("nav.products")}</a>
      <a href={r.contact} class="hover:text-rga-navy">{t("nav.contact")}</a>
    </nav>

    <!-- Mismo trato: en flujo en mobile, anclado al borde real del header
         (no a esta columna) desde sm:, para que viva siempre sobre el
         wave sin importar cuánto margen deje max-w-6xl en pantallas
         muy anchas. -->
    <a
      href={routes[otherLang].home}
      class="font-body text-sm font-medium text-rga-text sm:absolute sm:right-6 sm:top-1/2 sm:-translate-y-1/2 sm:text-white sm:hover:text-white/75"
    >
      {otherLang.toUpperCase()}
    </a>
  </div>

  <!-- Mobile-only remate: el header no tiene ancho de sobra para la banda
       fotográfica del wave (ver <style>, min-width 640px), así que aquí va
       una versión lineal del mismo gesto — silueta + pinstripe en SVG,
       liviana y siempre legible porque no vive detrás de texto. -->
  <div class="h-6 w-full sm:hidden" aria-hidden="true">
    <svg viewBox="0 0 400 24" preserveAspectRatio="none" class="block h-full w-full">
      <path
        d="M0 14 C110 2 260 22 400 10 L400 24 L0 24 Z"
        fill="#033773"
      ></path>
      <path
        d="M0 14 C110 2 260 22 400 10"
        fill="none"
        stroke="#ffffff"
        stroke-width="1.5"
        opacity="0.55"
      ></path>
    </svg>
  </div>
</header>

<style>
  /* Motion Wave entra por la derecha del header, detrás del selector de
     idioma, con un degradado blanco a la izquierda para que logo y nav
     sigan legibles — mismo gesto que la banda de las fichas técnicas. */
  @media (min-width: 640px) {
    .header-wave {
      background-image:
        linear-gradient(to right, #fff 0%, #fff 42%, rgba(255, 255, 255, 0) 78%),
        var(--wave-url);
      background-repeat: no-repeat, no-repeat;
      background-position:
        left top,
        right -85px center;
      background-size:
        100% 100%,
        540px auto;
    }

    /* Colchón de contraste: si "Contacto" queda al borde del wave en
       ventanas angostas, el halo blanco lo mantiene legible sin recolorear
       todo el nav (solo el selector de idioma, que sí queda sobre navy,
       pasa a blanco arriba). */
    .header-wave nav a {
      text-shadow:
        0 0 5px #fff,
        0 0 5px #fff,
        0 0 9px #fff;
    }
  }
</style>
